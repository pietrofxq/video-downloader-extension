{
  // TypeScript config for the v0.9 migration. We progressively rename
  // `.js` files to `.ts`; until every module is converted, `allowJs`
  // keeps the typechecker happy on the as-yet-unconverted files. Strict
  // flags ramp on at the END of the migration (see ROADMAP v0.9).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // Source layout
    "rootDir": ".",

    // We don't emit — esbuild bundles. tsc is purely the checker.
    "noEmit": true,

    // Interop with esbuild + npm packages
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    // v0.9 phase 7: strict checking lives on the release gate now.
    // Includes strictNullChecks / strictFunctionTypes / noImplicitAny /
    // useUnknownInCatchVariables / noImplicitThis. The follow-on flags
    // catch the remaining classes of bug we care about (missing
    // returns, fallthrough switches).
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    // Chrome extension globals. @types/chrome gives us the chrome.*
    // namespace; chrome120 target ensures the runtime APIs we use exist.
    // @types/node is for the dev-side test files (`node:fs`).
    "types": ["chrome", "node"]
  },
  "include": ["extension/**/*.ts"],
  "exclude": ["dist", "node_modules", "scripts", "build.mjs"]
}
